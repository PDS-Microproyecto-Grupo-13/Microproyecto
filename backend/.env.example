# ==============================================================================
# FastAPI Backend Configuration
# ==============================================================================

# Application Metadata
APP_NAME=mlops-backend
APP_VERSION=0.1.0
ENVIRONMENT=development

# API Routing
API_PREFIX=/api/v1

# Logging Configuration
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: console (colored rich output for dev) | json (structured 1-line JSON for prod)
LOG_FORMAT=console

# External Inference Service (MLflow / Model Serving HTTP endpoint)
INFERENCE_BASE_URL=http://inference:5001
INFERENCE_TIMEOUT_SECONDS=10.0

# CORS Configuration (comma-separated or single origin)
CORS_ORIGINS=http://localhost:5173
