# ==============================================================================
# SalaryPredict v1.0 — Plantilla de Variables de Entorno (Docker Compose)
# ==============================================================================
# Copie este archivo como .env en la raíz para personalizar la configuración.
# Si levanta todo el stack localmente con los defaults de docker-compose.yml,
# el archivo .env no es estrictamente obligatorio.

# ------------------------------------------------------------------------------
# Modelo y Alias Operacional en MLflow Model Registry
# ------------------------------------------------------------------------------
MODEL_NAME=salary-predictor
MODEL_ALIAS=champion

# ------------------------------------------------------------------------------
# Servidor MLflow Tracking
# ------------------------------------------------------------------------------
# Dentro de la red de Docker Compose, el servicio resuelve a http://mlflow-tracking:5000.
# Si apunta a un servidor MLflow externo o remoto, especifique su URI completa:
# MLFLOW_TRACKING_URI=http://mlflow-tracking:5000

# ------------------------------------------------------------------------------
# Configuración de CORS para el Backend FastAPI
# ------------------------------------------------------------------------------
# Orígenes web permitidos separados por coma.
# En despliegues remotos o instancias EC2, agregue el dominio o IP pública del servidor:
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
