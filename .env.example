# ==============================================================================
# Configuración local de SalaryPredict
# ==============================================================================
# Copie este archivo como .env y ajuste los valores. El archivo .env está en
# .gitignore: no se sube al repositorio y cada integrante mantiene el suyo.

# Servidor de MLflow del grupo (instancia EC2).
# La IP pública CAMBIA cada vez que se reinicia el laboratorio de AWS: hay que
# actualizarla aquí y volver a arrancar el servicio de inferencia.
# Déjela comentada para usar el MLflow local de Docker Compose.
MLFLOW_TRACKING_URI=http://CAMBIAR-POR-LA-IP:5000

# Modelo que sirve el sistema. El alias decide qué versión se despliega;
# promover una versión nueva es reasignar el alias, no reconstruir nada.
MODEL_NAME=salary_predict_model
MODEL_ALIAS=champion
