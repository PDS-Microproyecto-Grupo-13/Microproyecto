# ==============================================================================
# MLflow Tracking Server & Model Registry Configuration
# ==============================================================================

# Network Binding
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000

# Backend Metadata Store (SQLite local persistence)
MLFLOW_BACKEND_STORE_URI=sqlite:////var/lib/mlflow/db/mlflow.db

# Artifact Store Root (Mounted local volume)
MLFLOW_ARTIFACT_ROOT=/var/lib/mlflow/artifacts
